# Copy this file to backend/.env and fill in the real values.
# Never commit backend/.env or paste its values anywhere.

# From MongoDB Atlas: Connect > Drivers. Put your database user's password in it.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Any long random text. Generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-me

# Use true only on your own computer.
DJANGO_DEBUG=true

# Comma-separated, with no spaces.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8443

# From the Anthropic Console: API Keys. Never commit or share it.
ANTHROPIC_API_KEY=replace-me

# The Claude model the AI assistant uses.
LLM_MODEL=claude-sonnet-5-5

# Which prompt file in prompts/fish_chat/ the AI assistant uses.
FISH_CHAT_PROMPT_VERSION=v2

# From the Fishial portal (portal.fishial.ai): About > For developers > Create new API Key.
# Used for fish photo identification (User Story 6.1). Never commit or share them.
FISHIAL_CLIENT_ID=replace-me
FISHIAL_CLIENT_SECRET=replace-me
